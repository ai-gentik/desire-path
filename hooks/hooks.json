{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "DP_EVENT=UserPromptSubmit node $PLUGIN_DIR/scripts/logger.js",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "DP_EVENT=PostToolUse node $PLUGIN_DIR/scripts/logger.js",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "DP_EVENT=InstructionsLoaded node $PLUGIN_DIR/scripts/logger.js",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "DP_EVENT=Stop node $PLUGIN_DIR/scripts/logger.js",
            "async": true,
            "timeout": 5,
            "_comment": "Flush session to disk. Async so it never delays response."
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $PLUGIN_DIR/scripts/checker.js",
            "timeout": 12,
            "_comment": "BLOCKING. Runs after logger. If a pattern is ready, outputs JSON {decision:'block', reason:'...'} which tells Claude to surface a suggestion proactively instead of stopping. Silent when no pattern ready (exits 0 with no output)."
          }
        ]
      }
    ]
  }
}
